# ── Relay delivery rails (server keeps these secret) ──────────────
# Copy this file to `.env` (same folder) and fill in your keys.
# `.env` is gitignored — never commit real keys.

# Termii — Settings → API token in your dashboard (app.termii.ai)
TERMII_API_KEY=
# Approved sender ID, 3–11 chars (must be approved or delivery fails)
TERMII_SENDER=Relay
# dnd = transactional, delivers to DND numbers. generic = promo only 8am–8pm.
TERMII_CHANNEL=dnd

# Resend — API Keys in your dashboard (resend.com). Sending domain must be
# verified there; EMAIL_FROM must use that domain.
RESEND_API_KEY=
EMAIL_FROM=Relay <noreply@relay.app>

# Port for `npm run notify`
NOTIFY_PORT=3001

# ── Optional: direct browser mode (no server, keys ARE visible in bundle) ──
# Only for quick local testing. Prefer the server above.
# VITE_TERMII_API_KEY=
# VITE_TERMII_SENDER=Relay
# VITE_TERMII_CHANNEL=dnd
# VITE_RESEND_API_KEY=
